#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
# Set to 'development' for debugging or 'production' for live
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost/quizzapp/'

# If using HTTPS, set to 'https'
app.CSRFProtection  = false
app.CSRFTokenName   = 'csrf_test_name'
app.CSRFCookieName  = 'csrf_cookie_name'
app.CSRFExpire      = 7200
app.CSRFRegenerate  = true
app.CSRFExcludeURIs = ''

app.sessionExpiration  = 7200

#--------------------------------------------------------------------
# DATABASE (not used by default — app uses JSON file storage)
# Uncomment to switch to MySQL:
#--------------------------------------------------------------------
 database.default.hostname = localhost
 database.default.database = ecommerce_quiz_db
 database.default.username = root
 database.default.password =
 database.default.DBDriver = MySQLi
